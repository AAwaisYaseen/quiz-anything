# Copy to .env.local and fill in. Never prefix these with NEXT_PUBLIC_.

# Supabase: Project settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your Gemini key from Google AI Studio (keep billing off on that Google project).
# Leave empty to require every player to bring their own key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# New-question batches per UTC day allowed on YOUR key (players with their own key aren't counted).
DAILY_CAP=30
# New-question requests per IP per hour (applies to everyone).
RATE_LIMIT_PER_HOUR=10
